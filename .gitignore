# Rust build artifacts
/target/
**/*.rs.bk

# Python virtual environments & caches
/harness/.venv/
**/__pycache__/
*.pyc

# Node dependencies
**/node_modules/

# Ephemeral runtime keys (keep public telemetry JSONs, exclude private signing keys)
**/data/keys/
data/*.jsonl*.key
crates/*/data/

# Confidential internal IP & Patent filings (Never push to public Git)
/internal_ip/

# OS & editor files
.DS_Store
Thumbs.db

# Build output and local test state
/dist/
/bin/native/
/desktop/dist/
/desktop/src-tauri/target/
**/data/keys/
data/*.jsonl
*.key
.env
.env.*
!.env.example
.playwright-cli/

# Private enterprise stack and internal benchmark output — ships to customers,
# never in the public tree. Commit docker-compose.private-stack.example.yml instead.
docker-compose.private-stack.yml
deploy/k8s/*enterprise*
/results/
